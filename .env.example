# -----------------------------
# Runtime
# -----------------------------
# Node runtime mode for local development.
NODE_ENV=development
# Web dev port (change if 3000 is occupied).
WEB_PORT=3000
# Public web application URL used to build callback links.
APP_URL=http://localhost:3000
# API base URL used by clients and internal links.
API_URL=http://localhost:4000
# Public API URL exposed to Next.js browser runtime.
NEXT_PUBLIC_API_URL=http://localhost:4000
# API listen port.
API_PORT=4000

# -----------------------------
# Application Auth
# -----------------------------
# Local auth mode: magic_link (default), oauth in future.
AUTH_PROVIDER=magic_link
# Session/JWT signing secret for app auth.
JWT_SECRET=replace_me
# Sender address for magic-link emails (dev stub uses this as metadata).
MAGIC_LINK_FROM_EMAIL=no-reply@example.com

# -----------------------------
# Optional App OAuth Providers
# -----------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# -----------------------------
# X API Integration
# -----------------------------
# X OAuth client credentials from X Developer Portal.
X_CLIENT_ID=
X_CLIENT_SECRET=
# OAuth callback URL for X app.
X_REDIRECT_URI=http://localhost:4000/auth/x/callback
# Minimum scopes for read/write + token refresh capability.
X_SCOPES=tweet.read tweet.write users.read offline.access

# -----------------------------
# Data Stores
# -----------------------------
# Postgres connection string (docker compose local default).
DATABASE_URL=postgres://postgres:postgres@localhost:55432/growth_os
# Redis connection string for queue/cache/rate-limit state.
REDIS_URL=redis://localhost:56379

# -----------------------------
# Crypto
# -----------------------------
# 32-byte key used for token encryption/decryption at app level.
TOKEN_ENCRYPTION_KEY=replace_with_32_byte_key

# -----------------------------
# AI
# -----------------------------
# OpenAI API key used by generation orchestrator.
OPENAI_API_KEY=
# Default model identifier used by generation service.
OPENAI_MODEL=gpt-4.1-mini

# -----------------------------
# Observability
# -----------------------------
# Sentry DSN for backend/frontend error tracking.
SENTRY_DSN=
# Log verbosity: debug | info | warn | error.
LOG_LEVEL=info

# -----------------------------
# SMTP (optional local dev with MailHog)
# -----------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
