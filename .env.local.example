# Copy this file to .env.local for local secrets override.
# Values in .env.local should never be committed.

LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-local-dev-key
OPENROUTER_MODEL=openai/gpt-4.1-mini
X_CLIENT_ID=local-x-client-id
X_CLIENT_SECRET=local-x-client-secret
BETTER_AUTH_BASE_URL=http://localhost:4000
JWT_SECRET=local-dev-jwt-secret
BETTER_AUTH_SECRET=local-dev-better-auth-secret
TOKEN_ENCRYPTION_KEY=local-dev-32-byte-key
