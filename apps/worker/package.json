{
  "name": "@growth-os/worker",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @growth-os/shared build && ts-node-dev --respawn --transpile-only src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "coverage": "c8 --reporter=text --reporter=lcov --all --include 'src/**/*.ts' --exclude 'src/main.ts' tsx --test tests/**/*.test.ts"
  },
  "dependencies": {
    "bullmq": "5.34.4",
    "dotenv": "16.4.7",
    "@growth-os/shared": "workspace:*",
    "ioredis": "5.4.2",
    "pg": "8.13.1"
  },
  "devDependencies": {
    "@types/node": "22.10.1",
    "@types/pg": "8.11.11",
    "c8": "10.1.3",
    "ts-node-dev": "2.0.0",
    "tsx": "4.19.2",
    "typescript": "5.7.3"
  }
}
