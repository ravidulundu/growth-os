{
  "name": "@growth-os/worker",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @growth-os/shared build && ts-node-dev --respawn --transpile-only src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "node -e \"process.stdout.write('No worker tests yet\\\\n')\""
  },
  "dependencies": {
    "bullmq": "5.34.4",
    "dotenv": "16.4.7",
    "@growth-os/shared": "workspace:*",
    "ioredis": "5.4.2",
    "pg": "8.13.1"
  },
  "devDependencies": {
    "@types/node": "22.10.1",
    "@types/pg": "8.11.11",
    "ts-node-dev": "2.0.0",
    "typescript": "5.7.3"
  }
}
