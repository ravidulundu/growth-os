# Reference only. Do not commit real production secrets.
NODE_ENV=production
APP_URL=https://app.example.com
API_URL=https://api.example.com
NEXT_PUBLIC_API_URL=https://api.example.com
API_PORT=4000

AUTH_PROVIDER=magic_link
JWT_SECRET=from-secret-manager
MAGIC_LINK_FROM_EMAIL=no-reply@example.com

X_CLIENT_ID=from-secret-manager
X_CLIENT_SECRET=from-secret-manager
X_REDIRECT_URI=https://api.example.com/auth/x/callback
X_SCOPES=tweet.read tweet.write users.read offline.access

DATABASE_URL=from-secret-manager
REDIS_URL=from-secret-manager
TOKEN_ENCRYPTION_KEY=from-secret-manager
OPENAI_API_KEY=from-secret-manager
OPENAI_MODEL=gpt-4.1-mini
SENTRY_DSN=from-secret-manager
LOG_LEVEL=warn
