# Reference only. Do not commit real staging secrets.
NODE_ENV=staging
APP_URL=https://staging.example.com
API_URL=https://api-staging.example.com
BETTER_AUTH_BASE_URL=https://api-staging.example.com
NEXT_PUBLIC_API_URL=https://api-staging.example.com
API_PORT=4000

AUTH_PROVIDER=magic_link
JWT_SECRET=from-secret-manager
BETTER_AUTH_SECRET=from-secret-manager
MAGIC_LINK_FROM_EMAIL=no-reply@staging.example.com

X_CLIENT_ID=from-secret-manager
X_CLIENT_SECRET=from-secret-manager
X_REDIRECT_URI=https://api-staging.example.com/auth/x/callback
X_SCOPES=tweet.read tweet.write users.read offline.access

DATABASE_URL=from-secret-manager
REDIS_URL=from-secret-manager
TOKEN_ENCRYPTION_KEY=from-secret-manager
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=from-secret-manager
OPENROUTER_MODEL=openai/gpt-4.1-mini
SENTRY_DSN=from-secret-manager
LOG_LEVEL=info
