{
  "name": "@growth-os/ui",
  "private": true,
  "version": "0.1.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "coverage": "c8 --reporter=text --reporter=lcov --all --include 'src/**/*.ts' tsx --test tests/**/*.test.ts"
  },
  "devDependencies": {
    "c8": "10.1.3",
    "tsx": "4.19.2"
  }
}
